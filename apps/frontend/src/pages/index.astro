---
import Layout from '../layouts/Layout.astro';
import { InteractiveMapContainer } from '../components/map/InteractiveMapContainer';
import { HeroSearchBar } from '../components/search/HeroSearchBar';
import { MOCK_PLACES } from '../data/mock-places';

const featuredAttractions = MOCK_PLACES.filter((p) => p.type === 'attraction');
const featuredCabins = MOCK_PLACES.filter((p) => p.type === 'accommodation');
---

<Layout
  title="Turismo Capilla del Monte — Portal Oficial y Reservas Directas"
  description="Portal oficial de Capilla del Monte, Córdoba. Senderos al Cerro Uritorco, paseos naturales y reservas directas con prestadores habilitados."
>
  <!-- Hero Section Inmersivo con Fotografía Panorámica -->
  <section class="relative min-h-[90vh] flex flex-col justify-between bg-sand-900 text-white z-30">
    <!-- Imagen de Fondo Panorámica del Cerro Uritorco -->
    <div class="absolute inset-0 z-0 overflow-hidden">
      <img
        src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=2000&q=85"
        alt="Sierras de Capilla del Monte y Cerro Uritorco al atardecer"
        class="w-full h-full object-cover object-center brightness-[0.65] contrast-[1.05]"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-sand-900 via-sand-900/30 to-black/50" />
    </div>

    <!-- Contenido Superior: Identidad Editorial -->
    <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-8 lg:px-12 pt-28 sm:pt-36 w-full">
      <div class="max-w-3xl space-y-5">
        <h1 class="hero-anim font-display font-black text-4xl sm:text-6xl lg:text-7xl text-white tracking-[-0.03em] leading-[1.02]">
          El valle del Uritorco, directo y sin intermediarios.
        </h1>
        <p class="hero-anim text-base sm:text-xl text-sand-100/90 font-normal max-w-2xl leading-relaxed">
          Paseos de montaña, geología milenaria y reservas seguras con prestadores habilitados oficialmente por la Secretaría de Turismo.
        </p>
      </div>
    </div>

    <!-- Buscador Integrado Horizontal (CRO) anclado al pie del Hero -->
    <div class="relative z-40 max-w-[1600px] mx-auto px-4 sm:px-8 lg:px-12 pb-14 w-full mt-10">
      <div class="hero-anim">
        <HeroSearchBar client:load />
      </div>
    </div>
  </section>

  <!-- Dúo de Accesos Principales: Qué Hacer & Dónde Dormir -->
  <section class="relative z-10 py-16 sm:py-24 bg-sand-50">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 gsap-duo-container">
        <!-- Tarjeta Qué Hacer (Cero Badges, Cero Eyebrows) -->
        <a
          href="/atractivos"
          class="gsap-duo-card group relative h-[440px] rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-shadow duration-300 flex flex-col justify-end p-8 sm:p-12 border border-sand-200"
        >
          <img
            src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1200&q=80"
            alt="Parque Los Terrones y senderos de montaña"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent" />

          <div class="relative z-10 space-y-3">
            <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-white tracking-tight">
              Qué Hacer
            </h2>
            <p class="text-sm text-sand-200 line-clamp-2 max-w-md font-normal leading-relaxed">
              12 senderos catalogados: ascensos al Cerro Uritorco, cañadones rojizos en Los Terrones, ollas de agua en La Toma y espejos del dique El Cajón.
            </p>
            <div class="pt-2 flex items-center gap-2 text-sm font-semibold text-white group-hover:text-uritorco-300 transition-colors">
              <span>Explorar los circuitos y requisitos técnicos</span>
              <span class="group-hover:translate-x-1.5 transition-transform">→</span>
            </div>
          </div>
        </a>

        <!-- Tarjeta Dónde Dormir (Cero Badges, Cero Eyebrows, Alto Contraste y Calidez) -->
        <a
          href="/alojamientos"
          class="gsap-duo-card group relative h-[440px] rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-shadow duration-300 flex flex-col justify-end p-8 sm:p-12 border border-sand-200"
        >
          <img
            src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=1200&q=80"
            alt="Cabañas serranas al pie del cerro con vista nocturna cálida"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out brightness-90 contrast-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/55 to-black/20" />

          <div class="relative z-10 space-y-3">
            <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-white tracking-tight">
              Dónde Dormir
            </h2>
            <p class="text-sm text-sand-200 line-clamp-2 max-w-md font-normal leading-relaxed">
              Cabañas de piedra y algarrobo, posadas de montaña y hosterías de época. Trato directo con el prestador, sin comisiones ni sobreprecios.
            </p>
            <div class="pt-2 flex items-center gap-2 text-sm font-semibold text-white group-hover:text-primary-300 transition-colors">
              <span>Ver catálogo con tarifas transparentes</span>
              <span class="group-hover:translate-x-1.5 transition-transform">→</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Sección 1: «Hay mucho por descubrir.» (Bento Grid Asimétrico de Alto Contraste Sin Huecos) -->
  <section class="py-16 sm:py-24 bg-sand-50">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div class="max-w-2xl">
          <h2 class="font-display font-black text-3xl sm:text-5xl lg:text-6xl text-sand-900 tracking-tight leading-tight">
            Hay mucho por descubrir.
          </h2>
          <p class="mt-3 text-base sm:text-lg text-sand-600 font-normal">
            Naturaleza milenaria, cañadones rojizos y rincones secretos que vas a querer explorar.
          </p>
        </div>
        <a
          href="/atractivos"
          class="mt-4 md:mt-0 inline-flex items-center gap-2 text-sm font-bold text-primary-600 hover:text-primary-700 group cursor-pointer"
        >
          <span>Ver todos los paseos catalogados</span>
          <span class="group-hover:translate-x-1.5 transition-transform">→</span>
        </a>
      </div>

      <!-- Grilla Bento de 6 Destinos Icónicos (Row 1: 7 cols + 5 cols apilados; Row 2: 3 cols iguales) -->
      <div class="space-y-6 gsap-discover-grid">
        <!-- Fila 1: Gran Destino + Dúo Lateral Apilado -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
          <!-- Tarjeta 1 (Principal Grande): Los Terrones -->
          {(() => {
            const item = featuredAttractions.find((p) => p.id === 'att-2') || featuredAttractions[0];
            return (
              <a
                href={item.ctaUrl}
                class="gsap-discover-card lg:col-span-7 group relative min-h-[460px] sm:min-h-[520px] lg:h-[580px] rounded-3xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 flex flex-col justify-end p-8 sm:p-12 border border-sand-200/80 cursor-pointer"
              >
                <img
                  src={item.imageUrl}
                  alt={item.title}
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out brightness-95 contrast-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/55 to-transparent" />

                <div class="relative z-10 space-y-3">
                  <span class="block text-xs font-bold text-terracotta-400 tracking-widest uppercase">
                    {item.category}
                  </span>
                  <h3 class="font-display font-black text-3xl sm:text-4xl lg:text-5xl text-white leading-tight drop-shadow-sm">
                    {item.title}
                  </h3>
                  <p class="text-sm sm:text-base text-sand-100/90 font-normal leading-relaxed max-w-xl line-clamp-2">
                    {item.subtitle}
                  </p>
                  <div class="pt-2 flex flex-wrap items-center gap-x-5 gap-y-1.5 text-xs text-sand-200 font-medium">
                    <span class="flex items-center gap-1.5">
                      <svg class="w-4 h-4 text-sand-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="m3 11 19-9-9 19-2-8-8-2z"/>
                      </svg>
                      <span>{item.distanceFromCenter}</span>
                    </span>
                    <span class="flex items-center gap-1.5">
                      <svg class="w-4 h-4 text-sand-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                      </svg>
                      <span>{item.duration}</span>
                    </span>
                    <span class="flex items-center gap-1.5">
                      <svg class="w-4 h-4 text-sand-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="m8 3 4 8 5-5 5 15H2L8 3z"/>
                      </svg>
                      <span>Dificultad {item.difficulty?.toLowerCase()}</span>
                    </span>
                  </div>
                </div>
              </a>
            );
          })()}

          <!-- Columna Lateral Apilada (5 cols): Dique El Cajón + Balneario La Toma (278px + 24px + 278px = 580px) -->
          <div class="lg:col-span-5 flex flex-col gap-6">
            <!-- Tarjeta 2 (Mediana Superior): Dique El Cajón -->
            {(() => {
              const item = featuredAttractions.find((p) => p.id === 'att-4') || featuredAttractions[1];
              return (
                <a
                  href={item.ctaUrl}
                  class="gsap-discover-card flex-1 group relative min-h-[260px] lg:h-[278px] rounded-3xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 flex flex-col justify-end p-6 sm:p-8 border border-sand-200/80 cursor-pointer"
                >
                  <img
                    src={item.imageUrl}
                    alt={item.title}
                    class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out brightness-95 contrast-105"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/55 to-transparent" />

                  <div class="relative z-10 space-y-1.5">
                    <span class="block text-[11px] font-bold text-terracotta-400 tracking-widest uppercase">
                      {item.category}
                    </span>
                    <h3 class="font-display font-black text-2xl sm:text-3xl text-white leading-tight drop-shadow-sm">
                      {item.title}
                    </h3>
                    <div class="pt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-sand-200 font-medium">
                      <span class="flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-sand-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="m3 11 19-9-9 19-2-8-8-2z"/>
                        </svg>
                        <span>{item.distanceFromCenter}</span>
                      </span>
                      <span class="flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-sand-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                        </svg>
                        <span>{item.duration}</span>
                      </span>
                    </div>
                  </div>
                </a>
              );
            })()}

            <!-- Tarjeta 3 (Mediana Inferior): Balneario La Toma -->
            {(() => {
              const item = featuredAttractions.find((p) => p.id === 'att-5') || featuredAttractions[2];
              return (
                <a
                  href={item.ctaUrl}
                  class="gsap-discover-card flex-1 group relative min-h-[260px] lg:h-[278px] rounded-3xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 flex flex-col justify-end p-6 sm:p-8 border border-sand-200/80 cursor-pointer"
                >
                  <img
                    src={item.imageUrl}
                    alt={item.title}
                    class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out brightness-95 contrast-105"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/55 to-transparent" />

                  <div class="relative z-10 space-y-1.5">
                    <span class="block text-[11px] font-bold text-terracotta-400 tracking-widest uppercase">
                      {item.category}
                    </span>
                    <h3 class="font-display font-black text-2xl sm:text-3xl text-white leading-tight drop-shadow-sm">
                      {item.title}
                    </h3>
                    <div class="pt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-sand-200 font-medium">
                      <span class="flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-sand-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="m3 11 19-9-9 19-2-8-8-2z"/>
                        </svg>
                        <span>{item.distanceFromCenter}</span>
                      </span>
                      <span class="flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-sand-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                        </svg>
                        <span>{item.duration}</span>
                      </span>
                    </div>
                  </div>
                </a>
              );
            })()}
          </div>
        </div>

        <!-- Fila 2: Tres tarjetas iguales (El Zapato, Los Mogotes, Calle Techada) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Tarjeta 4: Geoforma El Zapato -->
          {(() => {
            const item = featuredAttractions.find((p) => p.id === 'att-3') || featuredAttractions[3];
            return (
              <a
                href={item.ctaUrl}
                class="gsap-discover-card group relative h-[320px] rounded-3xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 flex flex-col justify-end p-6 sm:p-8 border border-sand-200/80 cursor-pointer"
              >
                <img
                  src={item.imageUrl}
                  alt={item.title}
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out brightness-95 contrast-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/55 to-transparent" />

                <div class="relative z-10 space-y-1.5">
                  <span class="block text-[11px] font-bold text-terracotta-400 tracking-widest uppercase">
                    {item.category}
                  </span>
                  <h3 class="font-display font-black text-2xl text-white leading-snug drop-shadow-sm">
                    {item.title}
                  </h3>
                  <p class="text-xs text-sand-200 line-clamp-1 font-normal">
                    {item.subtitle}
                  </p>
                  <div class="pt-1 flex items-center gap-3 text-xs text-sand-200 font-medium">
                    <span>{item.distanceFromCenter}</span>
                    <span>•</span>
                    <span>{item.duration}</span>
                  </div>
                </div>
              </a>
            );
          })()}

          <!-- Tarjeta 5: Los Mogotes & Paso del Indio -->
          {(() => {
            const item = featuredAttractions.find((p) => p.id === 'att-7') || featuredAttractions[4];
            return (
              <a
                href={item.ctaUrl}
                class="gsap-discover-card group relative h-[320px] rounded-3xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 flex flex-col justify-end p-6 sm:p-8 border border-sand-200/80 cursor-pointer"
              >
                <img
                  src={item.imageUrl}
                  alt={item.title}
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out brightness-95 contrast-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/55 to-transparent" />

                <div class="relative z-10 space-y-1.5">
                  <span class="block text-[11px] font-bold text-terracotta-400 tracking-widest uppercase">
                    {item.category}
                  </span>
                  <h3 class="font-display font-black text-2xl text-white leading-snug drop-shadow-sm">
                    {item.title}
                  </h3>
                  <p class="text-xs text-sand-200 line-clamp-1 font-normal">
                    {item.subtitle}
                  </p>
                  <div class="pt-1 flex items-center gap-3 text-xs text-sand-200 font-medium">
                    <span>{item.distanceFromCenter}</span>
                    <span>•</span>
                    <span>{item.duration}</span>
                  </div>
                </div>
              </a>
            );
          })()}

          <!-- Tarjeta 6: Calle Techada & Casco Histórico -->
          {(() => {
            const item = featuredAttractions.find((p) => p.id === 'att-8') || featuredAttractions[5];
            return (
              <a
                href={item.ctaUrl}
                class="gsap-discover-card group relative h-[320px] rounded-3xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 flex flex-col justify-end p-6 sm:p-8 border border-sand-200/80 cursor-pointer"
              >
                <img
                  src={item.imageUrl}
                  alt={item.title}
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out brightness-95 contrast-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/55 to-transparent" />

                <div class="relative z-10 space-y-1.5">
                  <span class="block text-[11px] font-bold text-terracotta-400 tracking-widest uppercase">
                    {item.category}
                  </span>
                  <h3 class="font-display font-black text-2xl text-white leading-snug drop-shadow-sm">
                    {item.title}
                  </h3>
                  <p class="text-xs text-sand-200 line-clamp-1 font-normal">
                    {item.subtitle}
                  </p>
                  <div class="pt-1 flex items-center gap-3 text-xs text-sand-200 font-medium">
                    <span>{item.distanceFromCenter}</span>
                    <span>•</span>
                    <span>{item.duration}</span>
                  </div>
                </div>
              </a>
            );
          })()}
        </div>
      </div>
    </div>
  </section>

  <!-- Sección 2: «Destino Destacado: Cerro Uritorco» (Ancho Completo 100vw, Cero Slop, Editorial Bespoke) -->
  <section class="w-full bg-[#0e261d] text-white overflow-hidden relative">
    <!-- Fotografía Panorámica de Ancho Completo que arranca desde el borde superior -->
    <div class="w-full relative h-[500px] sm:h-[620px] lg:h-[720px] overflow-hidden">
      <img
        src="https://images.unsplash.com/photo-1544198365-f5d60b6d8190?auto=format&fit=crop&w=2400&q=85"
        alt="Cerro Uritorco y las Sierras Chicas al atardecer"
        class="w-full h-full object-cover object-center brightness-95 contrast-105"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#0e261d] via-black/20 to-black/60" />
    </div>

    <!-- Panel de Información de Ancho Completo en Verde Bosque (#0e261d) -->
    <div class="w-full bg-[#0e261d] -mt-16 sm:-mt-28 relative z-10 rounded-t-[32px] sm:rounded-t-[48px] border-t border-white/10 pt-12 sm:pt-16 pb-16 sm:pb-24">
      <div class="max-w-[1600px] mx-auto px-4 sm:px-8 lg:px-12 space-y-8">
        <div class="max-w-4xl space-y-4">
          <h2 class="font-display font-black text-4xl sm:text-6xl lg:text-7xl text-white tracking-tight leading-[1.05]">
            Cerro Uritorco
          </h2>
          <p class="text-base sm:text-xl text-sand-100/90 leading-relaxed font-normal max-w-3xl">
            El pico más alto de las Sierras Chicas y el símbolo indiscutido de Capilla del Monte. Se sube desde el Camino al Cerro, temprano a la mañana, y desde la cumbre se ve todo el Valle de Punilla, Los Gigantes y las Salinas Grandes.
          </p>
        </div>

        <div class="border-t border-white/15 pt-8 grid grid-cols-1 sm:grid-cols-3 gap-8 max-w-4xl">
          <div class="space-y-1.5">
            <div class="flex items-center gap-2 text-primary-400">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m8 3 4 8 5-5 5 15H2L8 3z"/>
              </svg>
              <span class="text-[11px] font-bold tracking-widest uppercase text-sand-300">Altura</span>
            </div>
            <p class="font-display font-bold text-xl sm:text-2xl text-white tracking-tight">1.979 m s. n. m.</p>
          </div>

          <div class="space-y-1.5">
            <div class="flex items-center gap-2 text-primary-400">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
              <span class="text-[11px] font-bold tracking-widest uppercase text-sand-300">Ascenso</span>
            </div>
            <p class="font-display font-bold text-xl sm:text-2xl text-white tracking-tight">5 a 7 h ida y vuelta</p>
          </div>

          <div class="space-y-1.5">
            <div class="flex items-center gap-2 text-primary-400">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
              </svg>
              <span class="text-[11px] font-bold tracking-widest uppercase text-sand-300">Acceso</span>
            </div>
            <p class="font-display font-bold text-xl sm:text-2xl text-white tracking-tight">Camino al Cerro, 4 km</p>
          </div>
        </div>

        <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a
            href="/atractivos/uritorco"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full bg-primary-500 hover:bg-primary-600 active:bg-primary-700 text-white font-bold text-xs tracking-wide transition-colors shadow-xl shadow-primary-500/25 cursor-pointer"
          >
            <span>Descubrir destino</span>
            <span>→</span>
          </a>
          <a
            href="/alojamientos?zone=la-toma"
            class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-white/10 hover:bg-white/15 active:bg-white/20 text-white font-bold text-xs tracking-wide transition-colors border border-white/20 text-center cursor-pointer"
          >
            Dormir cerca del cerro
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Teaser Editorial: Astroturismo & Cielos Bortle 3 (Cero Slop, Alto Impacto, CTA Directo) -->
  <section id="astroturismo" class="py-16 sm:py-24 bg-sand-50">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="relative rounded-3xl overflow-hidden bg-sand-900 text-white min-h-[380px] sm:min-h-[440px] flex flex-col justify-end p-8 sm:p-14 border border-sand-800 shadow-xl group">
        <!-- Imagen Panorámica Nocturna Auténtica -->
        <img

---
import Layout from '../layouts/Layout.astro';
import { InteractiveMapContainer } from '../components/map/InteractiveMapContainer';
import { MOCK_PLACES } from '../data/mock-places';

const featuredAttractions = MOCK_PLACES.filter((p) => p.type === 'attraction').slice(0, 3);
const featuredCabins = MOCK_PLACES.filter((p) => p.type === 'accommodation').slice(0, 3);
---

<Layout
  title="Turismo Capilla del Monte — Portal Oficial y Reservas Directas"
  description="Portal oficial de Capilla del Monte, Córdoba. Senderos al Cerro Uritorco, paseos naturales y reservas directas con prestadores habilitados."
>
  <!-- Hero Section Inmersivo con Fotografía de Montaña -->
  <section class="relative min-h-[85vh] flex flex-col justify-between bg-sand-900 text-white overflow-hidden">
    <!-- Imagen de Fondo Panorámica del Cerro Uritorco -->
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=2000&q=85"
        alt="Sierras de Capilla del Monte y Cerro Uritorco al atardecer"
        class="w-full h-full object-cover object-center brightness-[0.7] contrast-[1.05]"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-sand-900 via-sand-900/30 to-black/40" />
    </div>

    <!-- Contenido Superior: Identidad Editorial -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 sm:pt-36 w-full">
      <div class="max-w-3xl space-y-4">
        <span class="inline-block text-xs font-bold uppercase tracking-[0.2em] text-uritorco-300">
          Secretaría de Turismo • Capilla del Monte
        </span>
        <h1 class="font-display font-extrabold text-4xl sm:text-6xl lg:text-7xl text-white tracking-[-0.03em] leading-[1.05]">
          El valle del Uritorco, directo y sin intermediarios.
        </h1>
        <p class="text-base sm:text-xl text-sand-100/90 font-normal max-w-2xl leading-relaxed">
          Paseos de montaña, geología milenaria y reservas seguras con prestadores habilitados oficialmente en el pueblo.
        </p>
      </div>
    </div>

    <!-- Buscador Integrado Horizontal (CRO) anclado al pie del Hero -->
    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 w-full mt-12">
      <div class="bg-white rounded-2xl shadow-2xl p-4 sm:p-5 border border-sand-200">
        <form action="/alojamientos" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
          <div>
            <label for="checkIn" class="block text-[11px] font-bold text-sand-700 uppercase tracking-wider mb-1.5">
              Fecha de Ingreso
            </label>
            <input
              type="date"
              id="checkIn"
              name="checkIn"
              class="w-full px-3.5 py-2.5 rounded-xl border border-sand-300 text-sm text-sand-900 focus:outline-none focus:ring-2 focus:ring-primary-500 bg-sand-50/60 font-sans"
            />
          </div>

          <div>
            <label for="checkOut" class="block text-[11px] font-bold text-sand-700 uppercase tracking-wider mb-1.5">
              Fecha de Salida
            </label>
            <input
              type="date"
              id="checkOut"
              name="checkOut"
              class="w-full px-3.5 py-2.5 rounded-xl border border-sand-300 text-sm text-sand-900 focus:outline-none focus:ring-2 focus:ring-primary-500 bg-sand-50/60 font-sans"
            />
          </div>

          <div>
            <label for="guests" class="block text-[11px] font-bold text-sand-700 uppercase tracking-wider mb-1.5">
              Cantidad de Huéspedes
            </label>
            <select
              id="guests"
              name="guests"
              class="w-full px-3.5 py-2.5 rounded-xl border border-sand-300 text-sm text-sand-900 focus:outline-none focus:ring-2 focus:ring-primary-500 bg-sand-50/60 font-sans cursor-pointer"
            >
              <option value="1">1 Huésped</option>
              <option value="2" selected>2 Huéspedes</option>
              <option value="3">3 Huéspedes</option>
              <option value="4">4 Huéspedes</option>
              <option value="5">5 o más Huéspedes</option>
            </select>
          </div>

          <div>
            <button
              type="submit"
              class="w-full py-2.5 px-6 rounded-xl bg-primary-500 hover:bg-primary-600 active:bg-primary-700 text-white font-semibold text-sm transition-colors shadow-lg shadow-primary-500/25 cursor-pointer h-[42px] flex items-center justify-center gap-2"
            >
              <span>Buscar Disponibilidad</span>
              <span>→</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- Dúo de Accesos Principales: Qué Hacer & Dónde Dormir -->
  <section class="py-16 sm:py-24 bg-sand-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Tarjeta Qué Hacer -->
        <a
          href="/atractivos"
          class="group relative h-[420px] rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 flex flex-col justify-end p-8 sm:p-10 border border-sand-200"
        >
          <img
            src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1200&q=80"
            alt="Parque Los Terrones y senderos de montaña"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-black/10" />

          <div class="relative z-10 space-y-3">
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-uritorco-600 text-white inline-block">
              Naturaleza & Trekking
            </span>
            <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-white tracking-tight">
              Qué Hacer
            </h2>
            <p class="text-sm text-sand-200 line-clamp-2 max-w-md font-normal leading-relaxed">
              Ascensos a la cumbre del Cerro Uritorco, cañadones de Los Terrones, espejos de agua en El Cajón y ollas del río Calabalumba.
            </p>
            <div class="pt-2 flex items-center gap-2 text-sm font-semibold text-white group-hover:text-uritorco-300 transition-colors">
              <span>Explorar 12 circuitos oficiales</span>
              <span class="group-hover:translate-x-1.5 transition-transform">→</span>
            </div>
          </div>
        </a>

        <!-- Tarjeta Dónde Dormir -->
        <a
          href="/alojamientos"
          class="group relative h-[420px] rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 flex flex-col justify-end p-8 sm:p-10 border border-sand-200"
        >
          <img
            src="https://images.unsplash.com/photo-1587061949409-02df41d5e562?auto=format&fit=crop&w=1200&q=80"
            alt="Cabañas serranas al pie del cerro"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-black/10" />

          <div class="relative z-10 space-y-3">
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-primary-500 text-white inline-block">
              Hospedajes Habilitados
            </span>
            <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-white tracking-tight">
              Dónde Dormir
            </h2>
            <p class="text-sm text-sand-200 line-clamp-2 max-w-md font-normal leading-relaxed">
              Cabañas de piedra y madera, hosterías de época y posadas con vista panorámica a las sierras, verificadas por el municipio.
            </p>
            <div class="pt-2 flex items-center gap-2 text-sm font-semibold text-white group-hover:text-primary-300 transition-colors">
              <span>Ver catálogo con tarifas directas</span>
              <span class="group-hover:translate-x-1.5 transition-transform">→</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Paseos Icónicos: Composición Asimétrica (Bento) -->
  <section class="py-16 sm:py-24 bg-sand-100/60 border-t border-sand-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div class="max-w-xl">
          <h2 class="font-display font-extrabold text-3xl sm:text-5xl text-sand-900 tracking-tight">
            Paseos y Circuitos Icónicos
          </h2>
          <p class="mt-3 text-base text-sand-700 leading-relaxed font-normal">
            Rutas de montaña señalizadas y protegidas por guardaparques y defensa civil.
          </p>
        </div>
        <a
          href="/atractivos"
          class="mt-4 md:mt-0 inline-flex items-center gap-2 text-sm font-bold text-primary-600 hover:text-primary-700 group"
        >
          <span>Todos los paseos</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Atractivo Protagonista: Cerro Uritorco (Span 2) -->
        <article class="lg:col-span-2 relative rounded-3xl overflow-hidden bg-sand-900 text-white min-h-[440px] flex flex-col justify-end p-8 sm:p-12 shadow-xl border border-sand-200 group">
          <img
            src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1400&q=85"
            alt="Cerro Uritorco"
            class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-102 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent" />

          <div class="relative z-10 space-y-4 max-w-2xl">
            <div class="flex flex-wrap items-center gap-2">
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-white/20 backdrop-blur-xs text-white">
                1.979 msnm • Cumbre Mayor
              </span>
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-amber-500 text-sand-950">
                Dificultad Alta • 7-8 hs
              </span>
            </div>

            <h3 class="font-display font-black text-3xl sm:text-4xl text-white">
              Cerro Uritorco
            </h3>

            <p class="text-sm sm:text-base text-sand-200 leading-relaxed font-normal">
              El emblema máximo del Valle de Punilla. El ascenso exige calzado técnico, registro previo obligatorio en la base de La Toma y descenso antes del anochecer.
            </p>

            <div class="pt-2">
              <a
                href="/atractivos/uritorco"
                class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-white text-sand-900 hover:bg-sand-100 font-bold text-xs transition-colors"
              >
                Guía completa de ascenso →
              </a>
            </div>
          </div>
        </article>

        <!-- Columna Secundaria: Los Terrones y Dique El Cajón -->
        <div class="space-y-8 flex flex-col justify-between">
          <article class="relative rounded-3xl overflow-hidden bg-sand-900 text-white h-[208px] flex flex-col justify-end p-6 shadow-md border border-sand-200 group">
            <img
              src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=800&q=80"
              alt="Parque Los Terrones"
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent" />
            <div class="relative z-10 space-y-1">
              <span class="text-xs font-bold text-uritorco-300">Dificultad Media • 2-3 hs</span>
              <h4 class="font-display font-bold text-xl text-white">Parque Los Terrones</h4>
              <p class="text-xs text-sand-300 line-clamp-1">Formaciones de arenisca rojiza y cañadones.</p>
            </div>
          </article>

          <article class="relative rounded-3xl overflow-hidden bg-sand-900 text-white h-[208px] flex flex-col justify-end p-6 shadow-md border border-sand-200 group">
            <img
              src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80"
              alt="Dique El Cajón"
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent" />
            <div class="relative z-10 space-y-1">
              <span class="text-xs font-bold text-emerald-portal-300">Paseo Familiar • Sin Dificultad</span>
              <h4 class="font-display font-bold text-xl text-white">Dique El Cajón</h4>
              <p class="text-xs text-sand-300 line-clamp-1">Espejo de agua, paredones de piedra y mirador.</p>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- Alojamientos Destacados del Mes (Showcase con Precios Reales) -->
  <section class="py-16 sm:py-24 bg-sand-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div class="max-w-xl">
          <h2 class="font-display font-extrabold text-3xl sm:text-5xl text-sand-900 tracking-tight">
            Cabañas y Posadas Verificadas
          </h2>
          <p class="mt-3 text-base text-sand-700 leading-relaxed font-normal">
            Establecimientos formalmente inspeccionados y adheridos a la Comisión de Turismo.
          </p>
        </div>
        <a
          href="/alojamientos"
          class="mt-4 md:mt-0 inline-flex items-center gap-2 text-sm font-bold text-primary-600 hover:text-primary-700 group"
        >
          <span>Ver todas las cabañas</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {featuredCabins.map((cabin) => (
          <article class="bg-white rounded-3xl border border-sand-200 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group">
            <div class="relative h-60 w-full overflow-hidden bg-sand-200">
              <img
                src={cabin.imageUrl}
                alt={cabin.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent" />
              <div class="absolute top-4 left-4">
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-primary-500 text-white shadow-md">
                  Verificado Municipal
                </span>
              </div>
            </div>

            <div class="p-6 flex flex-col flex-grow justify-between space-y-4">
              <div>
                <span class="text-xs uppercase font-bold tracking-wider text-sand-500">
                  {cabin.category}
                </span>
                <h3 class="font-display font-bold text-xl text-sand-900 mt-1 group-hover:text-primary-600 transition-colors">
                  {cabin.title}
                </h3>
                <p class="text-xs text-sand-600 mt-2 line-clamp-2 leading-relaxed">
                  {cabin.subtitle}
                </p>
              </div>

              <div class="pt-4 border-t border-sand-100 flex items-center justify-between">
                <div>
                  <span class="text-[11px] text-sand-500 block">Tarifa por noche</span>
                  <span class="text-lg font-black text-sand-900">
                    ${(cabin.pricePerNight ?? 0).toLocaleString('es-AR')}
                  </span>
                </div>
                <a
                  href={cabin.ctaUrl}
                  class="px-4 py-2 rounded-xl bg-sand-900 hover:bg-primary-600 text-white font-semibold text-xs transition-colors"
                >
                  Consultar →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Mapa Interactivo Destacado con Leaflet -->
  <section class="py-16 sm:py-24 bg-sand-100/70 border-t border-sand-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div class="max-w-2xl">
          <h2 class="font-display font-extrabold text-3xl sm:text-5xl text-sand-900 tracking-tight">
            Explorá el Valle en el Mapa
          </h2>
          <p class="mt-3 text-base text-sand-700 leading-relaxed font-normal">
            Ubicá cabañas habilitadas, senderos al Uritorco, balnearios y diques. Hacé click en cualquier punto para ver tarifas y distancias.
          </p>
        </div>

        <div class="mt-4 md:mt-0 flex items-center gap-4 text-xs font-semibold text-sand-600">
          <div class="flex items-center gap-2">
            <span class="w-3.5 h-3.5 rounded-full bg-[#e06d39] inline-block shadow-xs"></span>
            <span>Cabañas Habilitadas</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-3.5 h-3.5 rounded-full bg-[#5c7e30] inline-block shadow-xs"></span>
            <span>Paseos & Senderos</span>
          </div>
        </div>
      </div>

      <InteractiveMapContainer client:only="react" />
    </div>
  </section>

  <!-- Circuito Patrimonial: Casonas con Historia (Captura Oficial) -->
  <section class="py-20 bg-[#4e261e] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-6">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-primary-300">
          Circuito Histórico & Arquitectónico
        </span>
        <h2 class="font-display font-extrabold text-3xl sm:text-5xl text-white tracking-tight">
          Casonas con Historia
        </h2>
        <p class="text-base sm:text-lg text-sand-200 leading-relaxed font-normal">
          A principios del siglo XX, Capilla del Monte fue el destino elegido por familias aristocráticas que construyeron residencias señoriales de estilo inglés, francés y pintoresquista. Descubrí el circuito autoguiado por el casco fundacional del pueblo.
        </p>
        <div class="pt-4">
          <a
            href="/atractivos/casonas"
            class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-primary-500 hover:bg-primary-600 active:bg-primary-700 text-white font-bold text-sm shadow-xl transition-all cursor-pointer"
          >
            Descargar Mapa del Circuito Patrimonial →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Respaldo Institucional (Anti-Estafas) -->
  <section class="py-16 sm:py-20 bg-sand-50 border-t border-sand-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-3xl border border-sand-200 p-8 sm:p-12 flex flex-col lg:flex-row items-center justify-between gap-8 shadow-sm">
        <div class="max-w-2xl space-y-2">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-portal-600">
            Seguridad Turística Municipal
          </span>
          <h3 class="font-display font-bold text-2xl sm:text-3xl text-sand-900">
            Reservá con la tranquilidad de prestadores registrados
          </h3>
          <p class="text-sm text-sand-600 leading-relaxed">
            Cada establecimiento publicado en este portal cuenta con inspección formal y habilitación vigente otorgada por la Secretaría de Turismo de Capilla del Monte, evitando sobreprecios y fraudes de alquileres no verificados.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 w-full lg:w-auto">
          <a
            href="/reservas/consulta"
            class="inline-flex items-center justify-center px-5 py-3 rounded-xl bg-sand-100 hover:bg-sand-200 text-sand-900 font-bold text-xs transition-colors text-center"
          >
            Consultar Mi Reserva
          </a>
          <a
            href="/alojamientos"
            class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-primary-500 hover:bg-primary-600 text-white font-bold text-xs transition-colors shadow-md shadow-primary-500/20 text-center"
          >
            Buscar Cabañas Habilitadas
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

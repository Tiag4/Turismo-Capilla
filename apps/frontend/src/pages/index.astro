---
import Layout from '../layouts/Layout.astro';
import { InteractiveMapContainer } from '../components/map/InteractiveMapContainer';
import { MOCK_PLACES } from '../data/mock-places';

const featuredAttractions = MOCK_PLACES.filter((p) => p.type === 'attraction');
const featuredCabins = MOCK_PLACES.filter((p) => p.type === 'accommodation');
---

<Layout
  title="Turismo Capilla del Monte — Portal Oficial y Reservas Directas"
  description="Portal oficial de Capilla del Monte, Córdoba. Senderos al Cerro Uritorco, paseos naturales y reservas directas con prestadores habilitados."
>
  <!-- Hero Section Inmersivo con Fotografía Panorámica -->
  <section class="relative min-h-[90vh] flex flex-col justify-between bg-sand-900 text-white overflow-hidden">
    <!-- Imagen de Fondo Panorámica del Cerro Uritorco -->
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=2000&q=85"
        alt="Sierras de Capilla del Monte y Cerro Uritorco al atardecer"
        class="w-full h-full object-cover object-center brightness-[0.65] contrast-[1.05]"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-sand-900 via-sand-900/30 to-black/50" />
    </div>

    <!-- Contenido Superior: Identidad Editorial -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 sm:pt-36 w-full">
      <div class="max-w-3xl space-y-5">
        <h1 class="hero-anim font-display font-black text-4xl sm:text-6xl lg:text-7xl text-white tracking-[-0.03em] leading-[1.02]">
          El valle del Uritorco, directo y sin intermediarios.
        </h1>
        <p class="hero-anim text-base sm:text-xl text-sand-100/90 font-normal max-w-2xl leading-relaxed">
          Paseos de montaña, geología milenaria y reservas seguras con prestadores habilitados oficialmente por la Secretaría de Turismo.
        </p>
      </div>
    </div>

    <!-- Buscador Integrado Horizontal (CRO) anclado al pie del Hero -->
    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 w-full mt-10">
      <div class="hero-anim bg-white rounded-3xl shadow-2xl p-4 sm:p-6 border border-sand-200">
        <form action="/alojamientos" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
          <div>
            <label for="checkIn" class="block text-[11px] font-bold text-sand-700 uppercase tracking-wider mb-1.5">
              Fecha de Ingreso
            </label>
            <input
              type="date"
              id="checkIn"
              name="checkIn"
              class="w-full px-3.5 py-2.5 rounded-xl border border-sand-300 text-sm text-sand-900 focus:outline-none focus:ring-2 focus:ring-primary-500 bg-sand-50/60 font-sans"
            />
          </div>

          <div>
            <label for="checkOut" class="block text-[11px] font-bold text-sand-700 uppercase tracking-wider mb-1.5">
              Fecha de Salida
            </label>
            <input
              type="date"
              id="checkOut"
              name="checkOut"
              class="w-full px-3.5 py-2.5 rounded-xl border border-sand-300 text-sm text-sand-900 focus:outline-none focus:ring-2 focus:ring-primary-500 bg-sand-50/60 font-sans"
            />
          </div>

          <div>
            <label for="guests" class="block text-[11px] font-bold text-sand-700 uppercase tracking-wider mb-1.5">
              Huéspedes
            </label>
            <select
              id="guests"
              name="guests"
              class="w-full px-3.5 py-2.5 rounded-xl border border-sand-300 text-sm text-sand-900 focus:outline-none focus:ring-2 focus:ring-primary-500 bg-sand-50/60 font-sans cursor-pointer"
            >
              <option value="1">1 Persona</option>
              <option value="2" selected>2 Personas</option>
              <option value="3">3 Personas</option>
              <option value="4">4 Personas</option>
              <option value="5">5 o más Personas</option>
            </select>
          </div>

          <div>
            <button
              type="submit"
              class="w-full py-2.5 px-6 rounded-xl bg-primary-500 hover:bg-primary-600 active:bg-primary-700 text-white font-semibold text-sm transition-colors shadow-lg shadow-primary-500/25 cursor-pointer h-[44px] flex items-center justify-center gap-2"
            >
              <span>Buscar Disponibilidad</span>
              <span class="text-base leading-none">→</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- Dúo de Accesos Principales: Qué Hacer & Dónde Dormir -->
  <section class="py-16 sm:py-24 bg-sand-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 gsap-duo-container">
        <!-- Tarjeta Qué Hacer (Cero Badges, Cero Eyebrows) -->
        <a
          href="/atractivos"
          class="gsap-duo-card group relative h-[440px] rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 flex flex-col justify-end p-8 sm:p-12 border border-sand-200"
        >
          <img
            src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1200&q=80"
            alt="Parque Los Terrones y senderos de montaña"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent" />

          <div class="relative z-10 space-y-3">
            <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-white tracking-tight">
              Qué Hacer
            </h2>
            <p class="text-sm text-sand-200 line-clamp-2 max-w-md font-normal leading-relaxed">
              12 senderos catalogados: ascensos al Cerro Uritorco, cañadones rojizos en Los Terrones, ollas de agua en La Toma y espejos del dique El Cajón.
            </p>
            <div class="pt-2 flex items-center gap-2 text-sm font-semibold text-white group-hover:text-uritorco-300 transition-colors">
              <span>Explorar los circuitos y requisitos técnicos</span>
              <span class="group-hover:translate-x-1.5 transition-transform">→</span>
            </div>
          </div>
        </a>

        <!-- Tarjeta Dónde Dormir (Cero Badges, Cero Eyebrows) -->
        <a
          href="/alojamientos"
          class="gsap-duo-card group relative h-[440px] rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 flex flex-col justify-end p-8 sm:p-12 border border-sand-200"
        >
          <img
            src="https://images.unsplash.com/photo-1587061949409-02df41d5e562?auto=format&fit=crop&w=1200&q=80"
            alt="Cabañas serranas al pie del cerro"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent" />

          <div class="relative z-10 space-y-3">
            <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-white tracking-tight">
              Dónde Dormir
            </h2>
            <p class="text-sm text-sand-200 line-clamp-2 max-w-md font-normal leading-relaxed">
              Cabañas de piedra y algarrobo, posadas de montaña y hosterías de época. Trato directo con el prestador, sin comisiones ni sobreprecios.
            </p>
            <div class="pt-2 flex items-center gap-2 text-sm font-semibold text-white group-hover:text-primary-300 transition-colors">
              <span>Ver catálogo con tarifas transparentes</span>
              <span class="group-hover:translate-x-1.5 transition-transform">→</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Paseos Icónicos: Composición Asimétrica (Bento) Enriquecida -->
  <section class="py-16 sm:py-24 bg-sand-100/60 border-t border-sand-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div class="max-w-2xl">
          <h2 class="font-display font-extrabold text-3xl sm:text-5xl text-sand-900 tracking-tight">
            Senderos y Circuitos Icónicos
          </h2>
          <p class="mt-3 text-base text-sand-700 leading-relaxed font-normal">
            Rutas de montaña señalizadas con datos técnicos verificados por guardaparques y guías habilitados.
          </p>
        </div>
        <a
          href="/atractivos"
          class="mt-4 md:mt-0 inline-flex items-center gap-2 text-sm font-bold text-primary-600 hover:text-primary-700 group"
        >
          <span>Todos los paseos</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 gsap-bento-grid">
        <!-- Atractivo Protagonista: Cerro Uritorco (Span 2) -->
        <article class="gsap-bento-item lg:col-span-2 relative rounded-3xl overflow-hidden bg-sand-900 text-white min-h-[460px] flex flex-col justify-end p-8 sm:p-12 shadow-xl border border-sand-200 group">
          <img
            src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1400&q=85"
            alt="Cerro Uritorco"
            class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-102 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/50 to-transparent" />

          <div class="relative z-10 space-y-4 max-w-2xl">
            <!-- Barra de datos técnicos editorial (sin badges flotantes) -->
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-semibold text-sand-300">
              <span class="text-white font-bold">1.979 msnm</span>
              <span class="text-sand-500">•</span>
              <span>7 a 8 hs ida y vuelta</span>
              <span class="text-sand-500">•</span>
              <span class="text-amber-300">Exigencia técnica alta</span>
              <span class="text-sand-500">•</span>
              <span>Registro en La Toma</span>
            </div>

            <h3 class="font-display font-black text-3xl sm:text-5xl text-white">
              Cerro Uritorco
            </h3>

            <p class="text-sm sm:text-base text-sand-200 leading-relaxed font-normal">
              El techo de las Sierras Chicas. El ascenso requiere calzado de montaña con suela de tracción, ración de 2 litros de agua por persona y registro presencial obligatorio antes de las 11:00 hs en la base de La Toma.
            </p>

            <div class="pt-2">
              <a
                href="/atractivos/uritorco"
                class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-white text-sand-900 hover:bg-sand-100 font-bold text-xs transition-colors"
              >
                Guía completa y requisitos de ascenso →
              </a>
            </div>
          </div>
        </article>

        <!-- Columna Secundaria: Los Terrones y Dique El Cajón -->
        <div class="space-y-8 flex flex-col justify-between">
          <article class="gsap-bento-item relative rounded-3xl overflow-hidden bg-sand-900 text-white h-[216px] flex flex-col justify-end p-6 shadow-md border border-sand-200 group">
            <img
              src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=800&q=80"
              alt="Parque Los Terrones"
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent" />
            <div class="relative z-10 space-y-1">
              <div class="text-[11px] font-semibold text-sand-300 flex items-center gap-2">
                <span>1.400 msnm</span>
                <span>•</span>
                <span>2 a 3 hs de circuito</span>
              </div>
              <h4 class="font-display font-bold text-xl text-white">Parque Los Terrones</h4>
              <p class="text-xs text-sand-300 line-clamp-2">Cañadones rojizos y formaciones de arenisca esculpidas hace 300 millones de años.</p>
            </div>
          </article>

          <article class="gsap-bento-item relative rounded-3xl overflow-hidden bg-sand-900 text-white h-[216px] flex flex-col justify-end p-6 shadow-md border border-sand-200 group">
            <img
              src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80"
              alt="Dique El Cajón"
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent" />
            <div class="relative z-10 space-y-1">
              <div class="text-[11px] font-semibold text-sand-300 flex items-center gap-2">
                <span>Paseo familiar accesible</span>
                <span>•</span>
                <span>Mirador y deportes sin motor</span>
              </div>
              <h4 class="font-display font-bold text-xl text-white">Dique El Cajón</h4>
              <p class="text-xs text-sand-300 line-clamp-2">Paredón de hormigón de 42m, espejo de agua cristalina y vista panorámica a Los Terrones.</p>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- Alojamientos Destacados: Alta Densidad de Datos (12 Establecimientos Verificados, Cero Badges) -->
  <section class="py-16 sm:py-24 bg-sand-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div class="max-w-xl">
          <h2 class="font-display font-extrabold text-3xl sm:text-5xl text-sand-900 tracking-tight">
            Cabañas y Posadas del Valle
          </h2>
          <p class="mt-3 text-base text-sand-700 leading-relaxed font-normal">
            Establecimientos formalmente inspeccionados por la Secretaría de Turismo, con habilitación vigente y contacto directo.
          </p>
        </div>
        <a
          href="/alojamientos"
          class="mt-4 md:mt-0 inline-flex items-center gap-2 text-sm font-bold text-primary-600 hover:text-primary-700 group"
        >
          <span>Ver catálogo completo ({featuredCabins.length})</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 gsap-cabins-grid">
        {featuredCabins.map((cabin, idx) => (
          <article class="gsap-cabin-card bg-white rounded-3xl border border-sand-200/90 overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col group">
            <div class="relative h-60 w-full overflow-hidden bg-sand-200">
              <img
                src={cabin.imageUrl}
                alt={cabin.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent" />
              <div class="absolute bottom-3 left-4 text-white">
                <span class="text-xs text-sand-200 font-medium block">
                  {cabin.category} · {cabin.zone}
                </span>
              </div>
            </div>

            <div class="p-6 flex flex-col flex-grow justify-between space-y-4">
              <div class="space-y-2">
                <h3 class="font-display font-bold text-xl text-sand-900 group-hover:text-primary-600 transition-colors leading-snug">
                  {cabin.title}
                </h3>
                <p class="text-xs text-sand-600 line-clamp-2 leading-relaxed">
                  {cabin.subtitle}
                </p>

                {cabin.capacity && (
                  <p class="text-xs font-semibold text-sand-800">
                    Capacidad: {cabin.capacity}
                  </p>
                )}

                {cabin.amenities && (
                  <p class="text-xs text-sand-500 line-clamp-1 pt-1">
                    {cabin.amenities.join(' · ')}
                  </p>
                )}
              </div>

              <div class="pt-4 border-t border-sand-100 flex items-end justify-between">
                <div>
                  <span class="text-xs text-emerald-portal-700 font-medium block mb-0.5">
                    Habilitación Municipal Nº {140 + idx}
                  </span>
                  <span class="text-[11px] text-sand-500 block">Por noche desde</span>
                  <span class="text-xl font-black text-sand-900">
                    ${(cabin.pricePerNight ?? 0).toLocaleString('es-AR')}
                  </span>
                </div>
                <a
                  href={cabin.ctaUrl}
                  class="px-4 py-2.5 rounded-xl bg-sand-900 hover:bg-primary-600 text-white font-semibold text-xs transition-colors cursor-pointer"
                >
                  Consultar →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Mapa Interactivo Destacado con Leaflet -->
  <section id="mapa-valle" class="py-16 sm:py-24 bg-sand-100/70 border-t border-sand-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div class="max-w-2xl">
          <h2 class="font-display font-extrabold text-3xl sm:text-5xl text-sand-900 tracking-tight">
            Explorá el Valle en el Mapa
          </h2>
          <p class="mt-3 text-base text-sand-700 leading-relaxed font-normal">
            Ubicá cabañas habilitadas, senderos al Uritorco, balnearios y diques. Hacé zoom o click en cualquier punto para ver tarifas y distancias reales.
          </p>
        </div>

        <div class="mt-4 md:mt-0 text-xs font-medium text-sand-600">
          12 alojamientos verificados y 5 paseos geolocalizados
        </div>
      </div>

      <div class="gsap-map-container">
        <InteractiveMapContainer client:only="react" />
      </div>
    </div>
  </section>

  <!-- Circuito Patrimonial: Casonas con Historia (Paseo Histórico, Cero Eyebrows) -->
  <section class="py-20 bg-[#3d2019] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-6 gsap-casonas-content">
        <h2 class="font-display font-extrabold text-3xl sm:text-5xl text-white tracking-tight">
          Casonas con Historia
        </h2>
        <p class="text-base sm:text-lg text-sand-200 leading-relaxed font-normal">
          A principios del siglo XX, la llegada del ferrocarril convirtió a Capilla del Monte en una distinguida villa de veraneo. Familias notables construyeron residencias señoriales de estilos normando, pintoresquista y Tudor con piedras de las canteras locales.
        </p>

        <!-- Datos clave del circuito -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4 border-t border-white/15">
          <div>
            <span class="block font-display font-black text-2xl sm:text-3xl text-primary-400">14</span>
            <span class="text-xs text-sand-300 font-medium">Residencias catalogadas</span>
          </div>
          <div>
            <span class="block font-display font-black text-2xl sm:text-3xl text-primary-400">2.5 km</span>
            <span class="text-xs text-sand-300 font-medium">Circuito peatonal autoguiado</span>
          </div>
          <div>
            <span class="block font-display font-black text-2xl sm:text-3xl text-primary-400">1910–1930</span>
            <span class="text-xs text-sand-300 font-medium">Época dorada fundacional</span>
          </div>
        </div>

        <div class="pt-4">
          <a
            href="/atractivos/casonas"
            class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-primary-500 hover:bg-primary-600 active:bg-primary-700 text-white font-bold text-xs tracking-wide shadow-xl transition-all cursor-pointer"
          >
            Descargar Mapa y Guía del Circuito Patrimonial →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Respaldo Institucional (Garantía Anti-Fraudes, Cero Eyebrows) -->
  <section class="py-16 sm:py-20 bg-sand-50 border-t border-sand-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="gsap-trust-card bg-white rounded-3xl border border-sand-200 p-8 sm:p-12 flex flex-col lg:flex-row items-center justify-between gap-8 shadow-sm">
        <div class="max-w-2xl space-y-2">
          <h3 class="font-display font-bold text-2xl sm:text-3xl text-sand-900">
            Tranquilidad y seguridad para tu estadía en las sierras
          </h3>
          <p class="text-sm text-sand-600 leading-relaxed">
            Cada establecimiento publicado en este portal cuenta con verificación técnica presencial y habilitación comercial otorgada por la Municipalidad de Capilla del Monte, protegiéndote contra estafas virtuales y alojamientos clandestinos.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 w-full lg:w-auto shrink-0">
          <a
            href="/reservas/consulta"
            class="inline-flex items-center justify-center px-5 py-3 rounded-xl bg-sand-100 hover:bg-sand-200 text-sand-900 font-bold text-xs transition-colors text-center"
          >
            Consultar Mi Reserva
          </a>
          <a
            href="/alojamientos"
            class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-primary-500 hover:bg-primary-600 text-white font-bold text-xs transition-colors shadow-md shadow-primary-500/20 text-center"
          >
            Buscar Cabañas Habilitadas
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<!-- GSAP ScrollTrigger Animations Script (Robusto: elementos nunca ocultos por defecto) -->
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  mm.add(
    {
      isNormal: '(prefers-reduced-motion: no-preference)',
      isReduced: '(prefers-reduced-motion: reduce)',
    },
    (context) => {
      const { isReduced } = context.conditions as { isReduced: boolean };

      if (isReduced) {
        return;
      }

      // Animación de entrada Hero (inmediata en carga de página)
      gsap.from('.hero-anim', {
        y: 24,
        opacity: 0,
        duration: 0.8,
        stagger: 0.12,
        ease: 'power2.out',
      });

      // Animación batch en scroll (elementos visibles en DOM, animan al entrar)
      ScrollTrigger.batch('.gsap-duo-card', {
        onEnter: (batch) => {
          gsap.from(batch, {
            y: 28,
            opacity: 0,
            duration: 0.7,
            stagger: 0.15,
            ease: 'power2.out',
            overwrite: 'auto',
          });
        },
        start: 'top 88%',
        once: true,
      });

      ScrollTrigger.batch('.gsap-bento-item', {
        onEnter: (batch) => {
          gsap.from(batch, {
            y: 24,
            opacity: 0,
            duration: 0.65,
            stagger: 0.1,
            ease: 'power2.out',
            overwrite: 'auto',
          });
        },
        start: 'top 88%',
        once: true,
      });

      ScrollTrigger.batch('.gsap-cabin-card', {
        onEnter: (batch) => {
          gsap.from(batch, {
            y: 24,
            opacity: 0,
            duration: 0.6,
            stagger: 0.08,
            ease: 'power2.out',
            overwrite: 'auto',
          });
        },
        start: 'top 90%',
        once: true,
      });

      ScrollTrigger.refresh();
    }
  );
</script>

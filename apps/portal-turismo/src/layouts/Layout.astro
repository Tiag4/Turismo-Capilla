---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Turismo Capilla del Monte — Portal Oficial',
  description = 'Descubrí los cerros, balnearios, paseos y alojamientos en Capilla del Monte, Córdoba. Reserva directa sin intermediarios.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- View Transitions Router (Astro 5) -->
    <ClientRouter />

    <!-- Google Fonts: Outfit & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-sand-50 text-sand-900 font-sans antialiased">
    <!-- Navbar Oficial Bespoke (Cero Vibecoded, Cero Eyebrows, Altura Disciplinada 68px) -->
    <header class="sticky top-0 z-40 bg-sand-50/95 backdrop-blur-md border-b border-sand-200/80">
      <div class="max-w-[1600px] mx-auto px-4 sm:px-8 lg:px-12 h-17 flex items-center justify-between">
        <!-- Logo Oficial de Capilla del Monte (Pueblo Uritorco) -->
        <a href="/" class="flex items-center group py-1" aria-label="Capilla del Monte — Pueblo Uritorco">
          <img
            src="/cropped-logo-capilla-del-monte-2024.png"
            alt="Capilla del Monte — Pueblo Uritorco"
            class="h-12 w-auto object-contain transition-transform duration-200 group-hover:scale-[1.02]"
            loading="eager"
          />
        </a>

        <!-- Enlaces Principales de Navegación -->
        <nav class="hidden md:flex items-center gap-7">
          <a
            href="/"
            class="text-sm font-semibold text-sand-900 hover:text-primary-600 transition-colors"
          >
            Inicio
          </a>
          <a
            href="/alojamientos"
            class="text-sm font-semibold text-sand-700 hover:text-primary-600 transition-colors"
          >
            Alojamientos
          </a>
          <a
            href="/atractivos"
            class="text-sm font-semibold text-sand-700 hover:text-primary-600 transition-colors"
          >
            Senderos & Paseos
          </a>
          <a
            href="/#mapa-valle"
            class="text-sm font-semibold text-sand-700 hover:text-primary-600 transition-colors"
          >
            Mapa del Valle
          </a>
          <a
            href="/atractivos/casonas"
            class="text-sm font-semibold text-sand-700 hover:text-primary-600 transition-colors"
          >
            Patrimonio
          </a>
          <a
            href="/astroturismo"
            class="text-sm font-semibold text-sand-700 hover:text-primary-600 transition-colors"
          >
            Astroturismo
          </a>
          <a
            href="/reservas/consulta"
            class="text-sm font-semibold text-sand-700 hover:text-primary-600 transition-colors"
          >
            Mi Reserva
          </a>
        </nav>

        <!-- CTA Panel Prestador & Menú Móvil -->
        <div class="flex items-center gap-3">
          <a
            href="/admin"
            class="hidden sm:inline-flex items-center justify-center text-xs font-semibold px-4 py-2.5 rounded-xl bg-sand-900 hover:bg-sand-800 text-white transition-colors cursor-pointer"
          >
            Acceso Prestadores
          </a>

          <!-- Botón de Menú Móvil -->
          <button
            type="button"
            id="mobile-menu-btn"
            aria-label="Abrir menú"
            class="md:hidden p-2 rounded-xl text-sand-800 hover:bg-sand-200 transition-colors"
          >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Menú Móvil Desplegable -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-sand-200 bg-sand-50 px-4 py-4 space-y-3">
        <a href="/" class="block text-sm font-semibold text-sand-900 py-1.5">Inicio</a>
        <a href="/alojamientos" class="block text-sm font-semibold text-sand-700 py-1.5">Alojamientos</a>
        <a href="/atractivos" class="block text-sm font-semibold text-sand-700 py-1.5">Senderos & Paseos</a>
        <a href="/#mapa-valle" class="block text-sm font-semibold text-sand-700 py-1.5">Mapa del Valle</a>
        <a href="/atractivos/casonas" class="block text-sm font-semibold text-sand-700 py-1.5">Patrimonio</a>
        <a href="/astroturismo" class="block text-sm font-semibold text-sand-700 py-1.5">Astroturismo</a>
        <a href="/reservas/consulta" class="block text-sm font-semibold text-sand-700 py-1.5">Mi Reserva</a>
        <div class="pt-2 border-t border-sand-200">
          <a href="/admin" class="block w-full text-center text-xs font-semibold py-2.5 rounded-xl bg-sand-900 text-white">
            Acceso Prestadores
          </a>
        </div>
      </div>
    </header>

    <script is:inline>
      document.addEventListener('astro:page-load', () => {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        if (btn && menu) {
          btn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
          });
        }
      });
    </script>

    <!-- Contenido Principal -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer Institucional Limpio y Expansivo (Desktop Wide) -->
    <footer class="bg-sand-900 text-sand-200 border-t border-sand-800 py-16">
      <div class="max-w-[1600px] mx-auto px-4 sm:px-8 lg:px-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-10 lg:gap-12">
        <div class="lg:col-span-2 space-y-4">
          <div class="flex items-center gap-3">
            <img
              src="/cropped-logo-capilla-del-monte-2024.png"
              alt="Capilla del Monte — Pueblo Uritorco"
              class="h-11 w-auto object-contain bg-white/95 px-2.5 py-1.5 rounded-xl shadow-sm"
              loading="lazy"
            />
            <div>
              <span class="font-display font-extrabold text-xl text-white block leading-tight">Turismo Capilla del Monte</span>
              <span class="text-xs text-sand-400 font-medium">Pueblo Uritorco · Portal Oficial</span>
            </div>
          </div>
          <p class="text-sm text-sand-300 max-w-md leading-relaxed">
            Plataforma oficial desarrollada en conjunto con la Comisión de Turismo de Capilla del Monte. Información verificada de circuitos serranos y reservas directas con prestadores habilitados oficialmente, sin comisiones ocultas.
          </p>
          <div class="pt-2 flex items-center gap-4 text-xs text-sand-400">
            <span class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-uritorco-500"></span>
              <span>Prestadores Habilitados</span>
            </span>
            <span class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-primary-500"></span>
              <span>Tarifa Transparente</span>
            </span>
          </div>
        </div>

        <div>
          <h4 class="font-display font-bold text-white mb-4 text-sm tracking-wide">
            Paseos & Naturaleza
          </h4>
          <ul class="space-y-2.5 text-sm text-sand-300">
            <li><a href="/atractivos" class="hover:text-primary-400 transition-colors">Cerro Uritorco</a></li>
            <li><a href="/atractivos" class="hover:text-primary-400 transition-colors">Los Terrones</a></li>
            <li><a href="/atractivos" class="hover:text-primary-400 transition-colors">Dique El Cajón</a></li>
            <li><a href="/atractivos" class="hover:text-primary-400 transition-colors">Balneario La Toma</a></li>
            <li><a href="/atractivos" class="hover:text-primary-400 transition-colors">Paseo El Zapato</a></li>
            <li><a href="/atractivos" class="hover:text-primary-400 transition-colors">Los Mogotes</a></li>
          </ul>
        </div>

        <div>
          <h4 class="font-display font-bold text-white mb-4 text-sm tracking-wide">
            Dónde Dormir
          </h4>
          <ul class="space-y-2.5 text-sm text-sand-300">
            <li><a href="/alojamientos?amenity=pileta-climatizada" class="hover:text-primary-400 transition-colors">Cabañas con pileta</a></li>
            <li><a href="/alojamientos?zone=falda-del-uritorco" class="hover:text-primary-400 transition-colors">Falda del Uritorco</a></li>
            <li><a href="/alojamientos?petFriendly=true" class="hover:text-primary-400 transition-colors">Alojamientos Pet-friendly</a></li>
            <li><a href="/alojamientos?zone=la-toma" class="hover:text-primary-400 transition-colors">Cerca del río</a></li>
            <li><a href="/alojamientos" class="hover:text-primary-400 transition-colors">Catálogo habilitado</a></li>
          </ul>
        </div>

        <div>
          <h4 class="font-display font-bold text-white mb-4 text-sm tracking-wide">
            Experiencias
          </h4>
          <ul class="space-y-2.5 text-sm text-sand-300">
            <li><a href="/astroturismo" class="hover:text-primary-400 transition-colors">Astroturismo Bortle 3</a></li>
            <li><a href="/atractivos/uritorco" class="hover:text-primary-400 transition-colors">Ascenso nocturno</a></li>
            <li><a href="/#mapa-valle" class="hover:text-primary-400 transition-colors">Mapa interactivo</a></li>
            <li><a href="/atractivos" class="hover:text-primary-400 transition-colors">Guías habilitados</a></li>
          </ul>
        </div>

        <div>
          <h4 class="font-display font-bold text-white mb-4 text-sm tracking-wide">
            Atención Turística
          </h4>
          <ul class="space-y-2.5 text-sm text-sand-300">
            <li class="text-sand-200 font-medium">Secretaría de Turismo</li>
            <li>Predio Estación Ferrocarril</li>
            <li>Tel: +54 3548 481903</li>
            <li>Guardia Turística: 103</li>
            <li class="pt-1 text-xs text-sand-400">Capilla del Monte, Valle de Punilla, Córdoba</li>
          </ul>
        </div>
      </div>

      <div class="max-w-[1600px] mx-auto px-4 sm:px-8 lg:px-12 mt-12 pt-8 border-t border-sand-800/80 flex flex-col sm:flex-row justify-between items-center text-xs text-sand-400 gap-4">
        <span>© 2026 Comisión de Turismo de Capilla del Monte. Todos los derechos reservados.</span>
        <div class="flex items-center gap-6">
          <a href="/astroturismo" class="hover:text-sand-300 transition-colors">Astroturismo</a>
          <a href="/alojamientos" class="hover:text-sand-300 transition-colors">Alojamientos</a>
          <a href="/atractivos" class="hover:text-sand-300 transition-colors">Paseos</a>
          <span>Programación III — Cátedra Universitaria</span>
        </div>
      </div>
    </footer>
  </body>
</html>

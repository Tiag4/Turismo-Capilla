---
import Layout from '../../layouts/Layout.astro';
import { AttractionsCatalogContainer } from '../../components/attractions/AttractionsCatalogContainer';
---

<Layout
  title="Senderos, Cumbres y Balnearios de Capilla del Monte — Portal Oficial"
  description="Catálogo oficial de paseos serranos, ascenso al Cerro Uritorco, Los Terrones, Dique El Cajón y balnearios naturales con altimetría y recomendaciones oficiales."
>
  <main class="min-h-screen bg-sand-50 text-sand-900">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-8 lg:px-12 py-8 sm:py-12">
      <AttractionsCatalogContainer client:load />
    </div>
  </main>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { BookingInquiryContainer } from '../../components/booking-inquiry/BookingInquiryContainer';
---

<Layout
  title="Consultar Reserva & Voucher Oficial — Turismo Capilla del Monte"
  description="Validá tu solicitud de reserva oficial y descargá tu voucher digital para presentar en tu alojamiento en Capilla del Monte."
>
  <main class="min-h-screen bg-sand-50 text-sand-900 py-8 sm:py-12">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-8 lg:px-12 space-y-8">
      {/* Encabezado Institucional Limpio (Anti-Vibecoded) */}
      <div class="max-w-4xl mx-auto text-center space-y-2 print:hidden">
        <span class="text-xs font-bold uppercase tracking-wider text-uritorco-700 block">
          Portal Oficial del Turista · Consulta de Vouchers
        </span>
        <h1 class="font-display font-black text-3xl sm:text-4xl text-sand-950 tracking-tight">
          Mis Reservas en Capilla del Monte
        </h1>
        <p class="text-sand-600 text-sm sm:text-base max-w-xl mx-auto">
          Accedé a tu voucher oficial, datos de contacto directo del anfitrión y comprobante de estadía garantizada.
        </p>
      </div>

      <BookingInquiryContainer client:load />
    </div>
  </main>
</Layout>
